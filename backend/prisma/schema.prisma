generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Category {
  id      String   @id @default(uuid())
  name    String   @unique
  slug    String   @unique
  news    News[]
  subTags SubTag[]
}

model SubTag {
  id         String   @id @default(uuid())
  name       String
  image      String?
  categoryId String
  news       News[]
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model News {
  id          String     @id @default(uuid())
  type        String     @default("REGULAR")
  category    String
  categoryTag String?
  title       String
  excerpt     String
  time        String
  image       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  content     String     @default("")
  viewCount   Int        @default(0)
  publishedAt DateTime   @default(now())
  status      NewsStatus @default(PUBLISHED)
  categoryId  String?
  subTagId    String?
  author      String?
  categoryRef Category?  @relation(fields: [categoryId], references: [id])
  subTag      SubTag?    @relation(fields: [subTagId], references: [id])
  players     Player[]   @relation("NewsToPlayer")
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  password             String
  name                 String?
  image                String?   @default("")
  role                 Role      @default(USER)
  resetToken           String?
  resetTokenExpires    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  onboardingCompleted  Boolean   @default(false)
  preferredCategories  String    @default("[]")
  followedPlayers      Player[]  @relation("UserFollowsPlayer")
}

model Player {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]   @relation("UserFollowsPlayer")
  news      News[]   @relation("NewsToPlayer")
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
  type  String @default("text")
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum Role {
  USER
  ADMIN
  EDITOR
}

model Analytics {
  id        String   @id @default(uuid())
  date      DateTime @unique @default(now())
  dau       Int      @default(0) // Daily Active Users (Authenticated)
  visitors  Int      @default(0) // Daily Unique Visitors (Anonymous + Auth)
  pageViews Int      @default(0) 
}

model DailyActivity {
  id        String   @id @default(uuid())
  userId    String?  // Null for anonymous
  visitorId String   // Unique ID from cookie/localStorage
  date      DateTime @default(now())
  
  @@unique([visitorId, date])
}
