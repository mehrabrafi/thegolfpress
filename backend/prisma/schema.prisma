generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Category {
  id      String   @id @default(uuid())
  name    String   @unique
  slug    String   @unique
  news    News[]
  subTags SubTag[]
}

model SubTag {
  id         String   @id @default(uuid())
  name       String
  categoryId String
  news       News[]
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model News {
  id          String     @id @default(uuid())
  type        String     @default("REGULAR")
  category    String
  categoryTag String?
  title       String
  excerpt     String
  time        String
  image       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  content     String     @default("")
  viewCount   Int        @default(0)
  publishedAt DateTime   @default(now())
  status      NewsStatus @default(PUBLISHED)
  categoryId  String?
  subTagId    String?
  categoryRef Category?  @relation(fields: [categoryId], references: [id])
  subTag      SubTag?    @relation(fields: [subTagId], references: [id])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
  type  String @default("text")
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum Role {
  USER
  ADMIN
  EDITOR
}

model HomeSection {
  id        String   @id @default(uuid())
  title     String
  category  String
  order     Int      @default(0)
  active    Boolean  @default(true)
  link      String?
  linkText  String?
  maxItems  Int      @default(4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Analytics {
  id        String   @id @default(uuid())
  date      DateTime @unique @default(now())
  dau       Int      @default(0) // Daily Active Users (Authenticated)
  visitors  Int      @default(0) // Daily Unique Visitors (Anonymous + Auth)
  pageViews Int      @default(0) 
}

model DailyActivity {
  id        String   @id @default(uuid())
  userId    String?  // Null for anonymous
  visitorId String   // Unique ID from cookie/localStorage
  date      DateTime @default(now())
  
  @@unique([visitorId, date])
}
