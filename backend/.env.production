# ──────────────────────────────────────────────────────────────────
# Backend Production Environment Variables
# Used by NestJS on the production server
# ──────────────────────────────────────────────────────────────────

# Ensure this is 'production'
NODE_ENV=production
PORT=5001

# Production DB URL
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# The URL of your frontend, used for CORS
FRONTEND_URL=https://thegolfpress.com
# Used in email links
APP_URL=https://thegolfpress.com

# ── CDN / R2 ─────────────────────────────────────────────────────
# Same as DEV, or put production keys here
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=thegolfpress
NEXT_PUBLIC_IMAGE_URL=https://cdn.thegolfpress.com

# ── Authentication ───────────────────────────────────────────────
# IMPORTANT: Generate a new strong secret for production
JWT_SECRET=GENERATED_SECRET_STRING_HERE
ALLOW_REGISTRATION=true

# ── Email Settings (Brevo) ───────────────────────────────────────
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_SMTP_USER=a2c554001@smtp-brevo.com
EMAIL_FROM="noreply@thegolfpress.com"
