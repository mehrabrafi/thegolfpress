// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}



enum NewsStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

model Category {
  id      String   @id @default(uuid())
  name    String   @unique
  slug    String   @unique
  news    News[]
  subTags SubTag[]
}

model SubTag {
  id         String   @id @default(uuid())
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  news       News[]
}

model News {
  id          String     @id @default(uuid())
  type        String     @default("REGULAR")
  category    String     // Keeping for display/legacy
  categoryId  String?
  categoryRef Category?  @relation(fields: [categoryId], references: [id])
  categoryTag String?    // Keeping for display/legacy
  subTagId    String?
  subTag      SubTag?    @relation(fields: [subTagId], references: [id])
  title       String
  excerpt     String
  time        String     // Keeping for display string, but using publishedAt for logic
  image       String
  content     String     @default("")
  status      NewsStatus @default(PUBLISHED)
  publishedAt DateTime   @default(now())
  viewCount   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
  EDITOR
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
  type  String @default("text") // text, image, email, etc.
}

