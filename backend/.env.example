# ─────────────────────────────────────────────────────────────────
# GolfWire Pro / The Golf Press — Production Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── App Environment ──────────────────────────────────────────────
# MUST be "production" in production to enable:
#   - Secure (HTTPS-only) cookies
#   - SameSite=strict cookies
#   - Strict CORS origin
NODE_ENV=production

# ── Server ───────────────────────────────────────────────────────
PORT=5001

# ── Database ─────────────────────────────────────────────────────
# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://user:password@localhost:5432/golfwire_db?schema=public

# ── Authentication ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be a strong, unique random string (64+ hex chars recommended)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# Set to "false" to disable public registration (recommended for production)
# New users can only be created by admins
ALLOW_REGISTRATION=false

# ── CORS / Frontend ─────────────────────────────────────────────
# The URL of your frontend app (used for CORS origin)
FRONTEND_URL=https://thegolfpress.com

# ── Cloudflare R2 (Image Storage) ───────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=thegolfpress

# ── CDN ──────────────────────────────────────────────────────────
# Public URL for serving uploaded images
NEXT_PUBLIC_IMAGE_URL=https://cdn.thegolfpress.com
